# Medorra Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API Gateway URL (e.g., https://xxxxxxxx.execute-api.us-east-1.amazonaws.com/prod)
NEXT_PUBLIC_API_URL=

# Cognito User Pool configuration
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# VAPID public key for web push (the raw "applicationServerKey", NOT the PEM file).
# Generate the matching private/public pair with py-vapid, then derive this value
# from the public key's raw uncompressed EC point, base64url-encoded, single line,
# no headers, no line breaks (~87 chars, typically starts with "B").
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
